---
import { footerRouter } from "../routes/router";

const year = new Date().getFullYear().toString();
---

<footer class="bg-primary">
    <div class="flex flex-col p-2 py-4 gap-4">
        <nav>
            <ul>
                {
                    footerRouter.map((route) => (
                        <li>
                            <a href={route.path}>{route.label}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <ul>TODO partners</ul>
    </div>

    <div
        class="bg-primary-dark text-white font-semibold text-center p-2 text-sm"
    >
        <span>
            &copy; Trampoline Intercité
            <span id="copy-year">
                {year}
            </span>
        </span>
    </div>
</footer>

<script>
    const year = new Date().getFullYear().toString();
    document.getElementById("copy-year")!.innerText = year;
</script>
