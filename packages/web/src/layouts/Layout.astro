---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TopArrow from "../components/TopArrow.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />

    <title>Trampoline Intercité</title>
  </head>
  <body style={{ "--header-height": "0px" }}>
    <div
      class="fixed top-0 left-0 z-50 bg-white -translate-y-full focus-within:translate-y-0 transition-all pointer-events-none"
    >
      <a href="#content" class="block font-bold text-lg p-2">
        Omettre la navigation
      </a>
    </div>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <TopArrow />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body[data-no-scroll="true"] {
    height: 100vh;
    overflow: hidden;
  }

  main {
    min-height: calc(100vh - var(--header-height));
  }
</style>

<script>
  // NOTE: When the header is loaded or resized, update the body's min-height.
  document.addEventListener("DOMContentLoaded", function () {
    const main = document.querySelector("main");
    const header = document.querySelector("header");

    if (main && header) {
      const resize = () =>
        document.body.style.setProperty(
          "--header-height",
          `${header.offsetHeight}px`,
        );

      resize();
      header.addEventListener("resize", resize);
    }
  });
</script>
