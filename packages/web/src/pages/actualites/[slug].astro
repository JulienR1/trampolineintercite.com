---
import type { GetStaticPaths } from "astro";
import { Article } from "common";
import { z } from "zod";
import Layout from "../../layouts/Layout.astro";
import Title from "../../components/Title.astro";

import _articles from "./articles.json";
import { dateTimeFormatter } from "../../lib/formatters";
import AuthorLink from "../../components/AuthorLink.astro";
import { cn } from "../../lib/utils";

export const getStaticPaths = (() => {
    const articles = z.array(Article).parse(_articles);
    return articles.map(({ slug }) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const article = z
    .array(Article)
    .parse(_articles)
    .find((article) => article.slug === slug)!;
---

<Layout title={article.title}>
    <Title title={article.title} />

    <article class="p-4 px-6 md:bg-red-300 max-w-4xl">
        {
            article.images.length > 0 && (
                <div
                    id="carousel"
                    style={{ "--selected": 0 }}
                    class="pb-2 sm:flex sm:max-h-72 sm:items-center sm:justify-center sm:gap-2"
                >
                    <div class="hidden sm:block">
                        <img {...article.images[0]} id="showcase" />
                    </div>

                    <div
                        id="carousel-extra"
                        class="block sm:overflow-y-auto sm:overflow-x-hidden sm:pr-2 sm:w-[var(--w)] sm:h-[var(--h)]"
                        style={{
                            "--h": `${Math.max(...article.images.map((img) => img.height))}px`,
                            "--w": `${Math.max(...article.images.map((img) => img.width / 3))}px`,
                        }}
                    >
                        <ul
                            class={cn([
                                "flex transition-all duration-300",
                                "w-[calc(var(--size)*100%)] translate-x-[var(--tx)]",
                                "sm:translate-x-0 sm:flex-col sm:w-fit",
                            ])}
                            style={{
                                "--size": article.images.length,
                                "--tx": "calc(-100% * var(--selected) / var(--size))",
                            }}
                        >
                            {article.images.map((image, i) => (
                                <li class="flex-1 sm:aspect-square sm:flex-none pb-2 last-of-type:pb-0">
                                    <button
                                        class="block mx-auto sm:data-[selected=true]:brightness-50 transition-all"
                                        data-selected={i === 0}
                                    >
                                        <img
                                            class="article-img block"
                                            {...image}
                                        />
                                    </button>
                                </li>
                            ))}
                        </ul>
                    </div>

                    {article.images.length > 1 && (
                        <ul class="flex gap-1 justify-center pt-4 sm:hidden">
                            {article.images.map((_, i) => (
                                <li
                                    class="indicator w-2 h-2 rounded-full bg-black opacity-50 data-[selected=true]:opacity-75"
                                    data-selected={(i === 0).toString()}
                                />
                            ))}
                        </ul>
                    )}
                </div>
            )
        }

        {
            article.contents.map((paragraph) => (
                <p class="text-justify pb-2">{paragraph}</p>
            ))
        }

        <footer>
            <p class="py-2">
                <span>Source: </span>
                <AuthorLink {...article.author} />
                {
                    (article.author.role ?? "").length > 0 && (
                        <span>, {article.author.role}</span>
                    )
                }
            </p>

            <div class="pt-2">
                <p>
                    <span>Publié le</span>
                    <time
                        datetime={article.releaseDate
                            .toISOString()
                            .split(".")[0]}
                    >
                        {dateTimeFormatter.format(article.releaseDate)}.
                    </time>
                </p>
                {
                    article.updateDate && (
                        <p>
                            <span>Mis à jour le</span>
                            <time
                                datetime={
                                    article.updateDate
                                        .toISOString()
                                        .split(".")[0]
                                }
                            >
                                {dateTimeFormatter.format(article.updateDate)}.
                            </time>
                        </p>
                    )
                }
            </div>
        </footer>
    </article>
</Layout>

<script>
    import { clamp } from "../../lib/maths";

    const carousel = document.getElementById("carousel")!;
    const images = carousel.querySelectorAll<HTMLImageElement>(".article-img");
    const indicators = carousel.querySelectorAll<HTMLElement>(".indicator");

    const extraImages = carousel.querySelectorAll<HTMLButtonElement>(
        "#carousel-extra button",
    );
    const showcaseImage =
        carousel.querySelector<HTMLImageElement>("#showcase")!;

    let startX: number | null = null;
    let startY: number | null = null;

    function selectImage(selected: number) {
        carousel.style.setProperty("--selected", selected.toString());

        indicators.forEach(
            (indicator) => (indicator.dataset.selected = "false"),
        );
        indicators.item(selected).dataset.selected = "true";

        extraImages.forEach((extra) => (extra.dataset.selected = "false"));
        extraImages.item(selected).dataset.selected = "true";

        showcaseImage.src = images[selected].src;
        showcaseImage.alt = images[selected].alt;
    }

    document.addEventListener("DOMContentLoaded", function () {
        for (const image of images) {
            image.addEventListener("touchstart", function (event) {
                if (
                    "changedTouches" in event &&
                    event.changedTouches.length > 0
                ) {
                    startX = event.changedTouches[0].screenX;
                    startY = event.changedTouches[0].screenY;
                }
            });

            image.addEventListener("touchend", function (event) {
                if (
                    startX !== null &&
                    startY !== null &&
                    "changedTouches" in event &&
                    event.changedTouches.length > 0
                ) {
                    const endX = event.changedTouches[0].screenX;
                    const endY = event.changedTouches[0].screenY;

                    if (Math.abs(endX - startX) > Math.abs(endY - startY)) {
                        const direction = startX > endX ? 1 : -1;
                        const currentlySelected = parseInt(
                            carousel.style.getPropertyValue("--selected") ||
                                "0",
                        );

                        selectImage(
                            clamp(
                                currentlySelected + direction,
                                0,
                                images.length - 1,
                            ),
                        );
                    }
                }

                startX = null;
                startY = null;
            });
        }

        for (const [index, extra] of extraImages.entries()) {
            extra.addEventListener("click", () => selectImage(index));
        }
    });
</script>

<style>
    #carousel-extra::-webkit-scrollbar {
        width: 6px;
    }

    #carousel-extra::-webkit-scrollbar-thumb {
        @apply bg-slate-300;
        @apply rounded-md;
    }

    #carousel-extra::-webkit-scrollbar-thumb:hover {
        @apply bg-slate-400;
    }
</style>
