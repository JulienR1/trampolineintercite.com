---
import ArticleCard from "../../components/ArticleCard.astro";
import Title from "../../components/Title.astro";
import Layout from "../../layouts/Layout.astro";
import { ArticlePreview } from "common";
import z from "zod";

// TODO: fetch these from the backend
import _articles from "./articles.json";
const articles = z
    .array(ArticlePreview)
    .parse(_articles)
    .map((article) => ({ ...article, tags: [...new Set(article.tags)] }))
    .sort(
        (a, b) =>
            (b.updateDate ?? b.releaseDate).getTime() -
            (a.updateDate ?? a.releaseDate).getTime(),
    );
---

<Layout>
    <Title title="Actualités" />

    <ul
        class="grid w-[90%] grid-cols-[minmax(90%,max-content)] justify-center max-w-7xl mx-auto mt-6"
    >
        {
            articles.map((article) => (
                <li>
                    <ArticleCard {...article} />
                </li>
            ))
        }
    </ul>
</Layout>
